# platform-admin settings — copy to .env on the server and fill in
# (values come from the Supabase stack .env or are generated on the server;
#  never type secrets in chat and never commit the real .env)
PORT=8092

# Domain that gets the platform admin surface (db.plotfarms.com).
# Requests on any other domain are treated as an app surface for that app.
PLATFORM_HOST=db.plotfarms.com
# Brand name shown on the admin pages (plain letters/digits/spaces).
PLATFORM_NAME=PlotFarms

# Supabase stack Postgres, reached over the supabase_default Docker network.
# This stack's Postgres listens on 5433 inside the containers.
DB_HOST=db
DB_PORT=5433
DB_NAME=postgres
DB_USER=platform_admin
DB_PASSWORD=

# Owner key — copied from the Supabase stack .env (OWNER_KEY value):
OWNER_KEY=

# Stack secrets copied from /root/supabase-selfhost/docker/.env:
#   echo "SUPABASE_JWT=$(grep -oP '^JWT_SECRET=\K.*' /root/supabase-selfhost/docker/.env)" >> .env
#   echo "SUPABASE_SERVICE_KEY=$(grep -oP '^SERVICE_ROLE_KEY=\K.*' /root/supabase-selfhost/docker/.env)" >> .env
SUPABASE_JWT=
SUPABASE_SERVICE_KEY=
SUPABASE_AUTH_URL=http://kong:8000

# Platform-surface sign-in (the Supabase dashboard username/password pair,
# copied from the stack .env) and a generated session secret:
#   echo "PLATFORM_SESSION_SECRET=$(openssl rand -hex 32)" >> .env
PLATFORM_ADMIN_USERNAME=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_SESSION_SECRET=
